# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   local to the developer. For a project, you might want to track these to lock the version.
# .python-version

# pipenv
#   Similar to pyenv, these are local to the developer.
#   For a project, you might want to track these to lock the dependencies.
# Pipfile.lock

# poetry
#   Similar to pyenv, these are local to the developer.
#   For a project, you might want to track these to lock the dependencies.
# poetry.lock

# pdm
#   Similar to poetry, these are local to the developer.
#   For a project, you might want to track these to lock the dependencies.
# .pdm.toml
# .pdm-python
# .pdm-build/

# venv
#   Useful for ignoring local python virtual environments
.venv/
venv/
ENV/
env/

